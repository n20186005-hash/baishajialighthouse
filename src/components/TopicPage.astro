---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

interface RelatedLink {
  href: string;
  label: string;
  desc: string;
  tag: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  eyebrow: string;
  h1: string;
  faqItems: { q: string; a: string }[];
  related?: RelatedLink[];
}

const { title, description, canonical, eyebrow, h1, faqItems, related = [] } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '白沙岬燈塔', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: h1, item: `${site.url}${canonical}` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="relative overflow-hidden bg-ocean-deep text-white">
    <div class="site-shell py-16 md:py-24">
      <nav aria-label="位置導覽" class="mb-6 text-xs font-bold tracking-[.12em] text-white/60">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a class="hover:text-white" href="/">白沙岬燈塔</a></li>
          <li aria-hidden="true">→</li>
          <li class="text-white/85">{h1}</li>
        </ol>
      </nav>
      <p class="eyebrow text-sand before:bg-white/30">{eyebrow}</p>
      <h1 class="mt-5 max-w-3xl text-4xl font-extrabold tracking-[-.045em] md:text-6xl">{h1}</h1>
      <slot name="intro" />
    </div>
  </section>

  <slot />

  <section id="faq" class="section-pad bg-paper">
    <div class="site-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr]">
      <div>
        <p class="eyebrow">出發之前</p>
        <h2 class="section-title">常見問題</h2>
        <p class="section-copy">開放時間與特殊活動可能臨時調整，出發前請再確認現場公告與最新開放狀況。</p>
      </div>
      <div class="divide-y divide-ocean/10 border-y border-ocean/10">
        {faqItems.map((item, index) => (
          <details class="group py-1" open={index === 0}>
            <summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-5 rounded-xl py-5 font-extrabold [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-ocean/20 text-ocean transition group-open:rotate-45" aria-hidden="true">＋</span>
            </summary>
            <p class="max-w-2xl pb-6 pr-12 text-sm leading-7 text-ink/60">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-pad border-t border-ocean/10 bg-foam">
      <div class="site-shell">
        <SectionHeading eyebrow="繼續探索" title="相關專題" copy="針對不同搜尋需求整理的白沙岬燈塔專頁。" />
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {related.map((link) => (
            <a class="group rounded-[2rem] border border-ocean/10 bg-paper p-7 transition hover:-translate-y-1 hover:shadow-xl" href={link.href}>
              <span class="text-xs font-black tracking-[.14em] text-ocean">{link.tag}</span>
              <h3 class="mt-4 text-xl font-extrabold tracking-tight">{link.label}</h3>
              <p class="mt-3 text-sm leading-7 text-ink/60">{link.desc}</p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-extrabold text-ocean transition group-hover:gap-2">查看專頁 →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-paper pb-20 md:pb-28">
    <div class="site-shell">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-ocean px-7 py-14 text-white md:px-14 md:py-16">
        <div class="relative max-w-3xl">
          <p class="text-xs font-black tracking-[.2em] text-white/65">桃園觀音・白沙岬燈塔</p>
          <h2 class="mt-5 text-3xl font-extrabold tracking-[-.045em] md:text-5xl">先看百年燈塔，<br />再走向觀音海岸。</h2>
          <p class="mt-6 max-w-2xl text-base leading-8 text-white/75">行程不用排得太滿，才能看見光影、老樹與海岸之間的細節。</p>
          <a class="focus-ring mt-8 inline-flex rounded-full bg-white px-6 py-3.5 text-sm font-extrabold text-ocean-deep" href="/">返回首頁總覽</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
