---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { nearbyPlaces, nearbyMapUrl, nearbyUrl } from '../../data/nearby';
import { site } from '../../data/site';

export function getStaticPaths() {
  return nearbyPlaces.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}
type Place = (typeof nearbyPlaces)[number];
const { place } = Astro.props as { place: Place };
const canonical = nearbyUrl(place.slug);
const mapUrl = nearbyMapUrl(place.name, place.district);
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: place.faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const schema = {
  '@context': 'https://schema.org', '@type': 'TouristAttraction', name: place.name,
  alternateName: place.english, description: place.intro, url: `${site.url}${canonical}`,
  image: `${site.url}${place.image}`,
  address: { '@type': 'PostalAddress', streetAddress: place.district, addressRegion: '桃園市', addressCountry: 'TW' },
  ...('latitude' in place ? { geo: { '@type': 'GeoCoordinates', latitude: place.latitude, longitude: place.longitude } } : {}),
  hasMap: mapUrl,
  subjectOf: { '@type': 'WebPage', url: place.official },
};
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '白沙岬燈塔', item: site.url },
  { '@type': 'ListItem', position: 2, name: '周邊景點', item: `${site.url}/nearby-attractions/` },
  { '@type': 'ListItem', position: 3, name: place.name, item: `${site.url}${canonical}` },
] };
---
<BaseLayout title={`${place.name}旅遊攻略｜歷史特色、交通、路線與拍照建議`} description={`${place.name}怎麼玩？整理景點背景、基本資訊、參觀重點、路線、交通導航與拍照建議，串聯白沙岬燈塔觀音海線行程。`} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="bg-ocean-deep py-16 text-white md:py-24">
    <div class="site-shell">
      <nav aria-label="位置導覽" class="text-sm text-white/70"><a href="/">白沙岬燈塔</a> / <a href="/nearby-attractions/">周邊景點</a> / {place.name}</nav>
      <p class="eyebrow mt-10 text-sand">{place.type}</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-extrabold tracking-tight md:text-6xl">{place.name}</h1>
      <p class="mt-3 text-lg text-white/65">{place.english}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3 text-sm font-bold text-white/85"><span class="rounded-full border border-white/25 px-4 py-2">{place.hours}</span><span class="rounded-full border border-white/25 px-4 py-2">{place.district}</span></div>
      <p class="mt-7 max-w-3xl text-lg leading-8 text-white/85">{place.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-white px-6 py-3 font-extrabold text-ocean-deep" href={mapUrl} target="_blank" rel="noopener noreferrer">Google Maps 景點與評價 ↗</a><a class="rounded-full border border-white/40 px-6 py-3 font-bold" href="/nearby-attractions/">查看海線其他景點</a></div>
    </div>
  </section>
  <section id="about-attraction" class="section-pad bg-paper" aria-labelledby="about-heading"><div class="site-shell grid items-start gap-8 lg:grid-cols-[.34fr_.66fr]"><div><p class="eyebrow">關於景點</p><h2 id="about-heading" class="section-title">關於{place.name}</h2><p class="mt-5 text-sm font-bold text-ocean">管理與地方背景</p></div><div class="rounded-[2rem] border border-ocean/10 bg-foam p-7 md:p-10"><p class="text-lg leading-9 text-ink/80">{place.management}</p><a class="mt-6 inline-flex text-sm font-bold text-ocean underline" href={place.managementSource} target="_blank" rel="noopener noreferrer">參考管理機關或相關官方資料 ↗</a></div></div></section>
  <section class="bg-paper pt-10"><div class="site-shell"><figure class="overflow-hidden rounded-[2rem] bg-foam"><img src={place.image} alt={`${place.name}真實景點照片：${place.type}`} width="1024" height="683" loading="eager" decoding="async" class="h-[260px] w-full object-cover md:h-[460px]"/><figcaption class="px-6 py-3 text-xs text-ink/55">{place.name}實景 · 圖片來源：桃園觀光導覽網／政府公開景點圖片</figcaption></figure></div></section>
  <section id="discover" class="section-pad bg-paper"><div class="site-shell"><SectionHeading eyebrow="探索景點" title={`走進${place.name}`} copy={place.intro}/><div class="mt-10 grid gap-5 md:grid-cols-2"><article class="soft-card p-7"><h3 class="text-xl font-extrabold">遊覽建議</h3><p class="mt-4 leading-8 text-ink/70">{place.visitTip}</p></article><article class="soft-card p-7"><h3 class="text-xl font-extrabold">景區特色與觀察重點</h3><p class="mt-4 leading-8 text-ink/70">{place.detail}</p></article></div></div></section>
  <section id="basic-info" class="section-pad bg-paper"><div class="site-shell"><SectionHeading eyebrow="行前速覽" title="基本資料"/><dl class="mt-9 grid gap-4 md:grid-cols-2 lg:grid-cols-3"><div class="soft-card p-6"><dt class="text-sm font-bold text-ink/50">正式名稱</dt><dd class="mt-2 font-extrabold">{place.name}<span class="block mt-1 text-sm font-normal text-ink/60">{place.english}</span></dd></div><div class="soft-card p-6"><dt class="text-sm font-bold text-ink/50">地址／地點範圍</dt><dd class="mt-2 font-bold">{place.district}</dd></div><div class="soft-card p-6"><dt class="text-sm font-bold text-ink/50">景點類型</dt><dd class="mt-2 font-bold">{place.type}</dd></div><div class="soft-card p-6"><dt class="text-sm font-bold text-ink/50">開放時間</dt><dd class="mt-2 font-bold">{place.hours}</dd></div><div class="soft-card p-6"><dt class="text-sm font-bold text-ink/50">參觀費用</dt><dd class="mt-2 font-bold">{place.admission}</dd></div><div class="soft-card p-6"><dt class="text-sm font-bold text-ink/50">建議停留</dt><dd class="mt-2 font-bold">約 30–90 分鐘，依場域與步行距離調整</dd></div></dl></div></section>
  <section class="section-pad bg-foam"><div class="site-shell grid gap-7 md:grid-cols-3"><div><h2 class="section-title">開放時間</h2><p class="mt-4 leading-8 text-ink/70">{place.hours}</p><p class="mt-3 text-sm leading-7 text-ink/60">館舍、祭典、海岸與管制區可能各有不同安排，請以管理單位最新公告為準。</p></div><div><h2 class="section-title">門票價格</h2><p class="mt-4 leading-8 text-ink/70">{place.admission}</p><p class="mt-3 text-sm leading-7 text-ink/60">若參加專人導覽、體驗或租用設備，請另外查詢活動費用。</p></div><div><h2 class="section-title">交通方式</h2><p class="mt-4 leading-8 text-ink/70">{place.travelDetail}</p><a class="mt-3 inline-flex text-sm font-extrabold text-ocean underline" href="https://ebus.tycg.gov.tw/" target="_blank" rel="noopener noreferrer">查詢桃園公車動態 ↗</a></div></div></section>
  <section class="section-pad bg-foam"><div class="site-shell"><SectionHeading eyebrow="發現魅力" title="歷史、建築與地景的故事"/><div class="mt-10 grid gap-5 md:grid-cols-2"><article class="soft-card p-8"><h3 class="text-xl font-extrabold">歷史與地方文化</h3><p class="mt-4 leading-8 text-ink/70">{place.history}</p></article><article class="soft-card p-8"><h3 class="text-xl font-extrabold">建築或地形特色</h3><p class="mt-4 leading-8 text-ink/70">{place.architecture}</p></article></div></div></section>
  <section class="section-pad bg-paper"><div class="site-shell"><SectionHeading eyebrow="遊覽路線" title="從白沙岬燈塔順遊的安排" copy="以下是建議順序，並非即時交通或固定班次；請依路況、開放時間與天候調整。"/><ol class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{place.route.map((step, i) => <li class="soft-card p-7"><span class="text-3xl font-black text-ocean">{String(i+1).padStart(2,'0')}</span><p class="mt-5 leading-7">{step}</p></li>)}</ol></div></section>
  <section class="section-pad bg-foam"><div class="site-shell grid gap-8 md:grid-cols-2"><div><h2 class="section-title">遊覽須知</h2><p class="mt-5 leading-8 text-ink/70">{place.visitTip}</p><p class="mt-4 text-sm leading-7 text-ink/60">尊重現場標示、管理規範及其他訪客；海岸與潮間帶景點尤其需要留意風勢、潮汐和安全區域。</p></div><div><h2 class="section-title">拍照機位</h2><p class="mt-5 leading-8 text-ink/70">{place.photo}</p><p class="mt-4 leading-8 text-ink/70">{place.architecture}</p></div></div></section>
  <section class="section-pad bg-paper"><div class="site-shell grid gap-8 md:grid-cols-2"><div><h2 class="section-title">住宿建議</h2><p class="mt-5 leading-8 text-ink/70">{place.lodging}</p></div><div><h2 class="section-title">遊客評價與體驗</h2><p class="mt-5 leading-8 text-ink/70">想了解旅客對{place.name}的近期體驗，可以參考 Google 地圖上的公開評價與近期實景照片；也可留意評論中提到的交通、停留時間與現場設施是否符合自己的需求。</p><a class="mt-4 inline-flex font-extrabold text-ocean underline" href={mapUrl} target="_blank" rel="noopener noreferrer">查看 Google 地圖近期評價 ↗</a></div></div></section>
  <section class="section-pad bg-foam"><div class="site-shell grid gap-9 lg:grid-cols-[.6fr_.4fr]"><div><p class="eyebrow">交通指南</p><h2 class="section-title">{place.name}地址與地圖</h2><p class="mt-5 text-lg font-extrabold">{place.district}</p><p class="mt-4 leading-8 text-ink/70">{place.travelDetail}</p><p class="mt-4 text-sm leading-7 text-ink/60">大型海岸地景和自行車路線通常不只有一個入口；出發前請選好適合的公開入口與停車點。</p></div><div class="soft-card flex flex-col justify-center p-8"><a class="rounded-full bg-ocean px-6 py-4 text-center font-extrabold text-white" href={mapUrl} target="_blank" rel="noopener noreferrer">Google Maps 導航至 {place.name} ↗</a><a class="mt-5 text-center text-sm font-bold text-ocean underline" href={place.official} target="_blank" rel="noopener noreferrer">查看景點官方參考資料 ↗</a></div></div></section>
  <section class="section-pad bg-paper"><div class="site-shell"><SectionHeading eyebrow="出發前核對" title="常見問題"/><div class="mt-9 max-w-3xl divide-y divide-ocean/10">{place.faq.map(item => <details class="py-5"><summary class="cursor-pointer font-extrabold">{item.q}</summary><p class="mt-3 leading-8 text-ink/70">{item.a}</p></details>)}</div><p class="mt-9 text-sm leading-7 text-ink/55">資料參考：<a class="text-ocean underline" href={place.official} target="_blank" rel="noopener noreferrer">桃園觀光導覽網相關景點／遊程</a>（2026 年 11 月 18 日查閱）。本站不展示未核實的評分或評論數；最新營業、交通與活動資訊請依來源及現場公告。</p></div></section>
  <section class="bg-paper py-16"><div class="site-shell"><h2 class="text-2xl font-extrabold">附近還能去哪裡？</h2><div class="mt-6 flex flex-wrap gap-3">{nearbyPlaces.filter(item => item.slug !== place.slug).slice(0, 5).map(item => <a class="rounded-full border border-ocean/20 bg-foam px-5 py-3 text-sm font-bold text-ocean" href={nearbyUrl(item.slug)}>{item.name} →</a>)}</div><a class="mt-8 inline-flex rounded-full border border-ocean/20 px-6 py-3 font-extrabold text-ocean" href="/nearby-attractions/">← 返回周邊景點總覽</a></div></section>
</BaseLayout>
