---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Weather from '../components/Weather.astro';
import {
  audienceRoutes,
  faq,
  fullDayItinerary,
  highlights,
  itinerary,
  quickFacts,
  scienceNotes,
  seasonGuide,
  seasonalHours,
  site,
  stories,
  timeline,
  transport,
  visitorRules,
  visitorServices,
  weeklyClosure,
} from '../data/site';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  '@id': `${site.url}/#attraction`,
  name: '白沙岬燈塔',
  alternateName: [
    '觀音白沙岬燈塔',
    '桃園白沙岬燈塔',
    '白沙燈塔',
    'Baishajia Lighthouse',
    'Baishajia Lighthouse (Guanyin, Taoyuan)',
  ],
  description: site.description,
  url: site.url,
  image: [
    `${site.url}/images/optimized/hero.webp`,
    `${site.url}/images/optimized/tower-detail.webp`,
    `${site.url}/images/optimized/entrance.webp`,
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '光明路216號',
    addressLocality: '觀音區',
    addressRegion: '桃園市',
    postalCode: '328',
    addressCountry: 'TW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.latitude,
    longitude: site.longitude,
  },
  hasMap: site.mapsShareUrl,
  sameAs: [site.mapsShareUrl, site.govTourismUrl],
  telephone: '+886-3-473-2249',
  touristType: ['親子旅客', '攝影愛好者', '文化旅遊者', '自行車旅客'],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: '洗手間', value: true },
    { '@type': 'LocationFeatureSpecification', name: '停車空間', value: true },
    { '@type': 'LocationFeatureSpecification', name: '休憩座椅', value: true },
    { '@type': 'LocationFeatureSpecification', name: '免門票參觀', value: true },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '09:00',
      closes: '18:00',
      validFrom: '--04-01',
      validThrough: '--10-31',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '09:00',
      closes: '17:00',
      validFrom: '--11-01',
      validThrough: '--03-31',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '白沙岬燈塔', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: '觀音區' },
    { '@type': 'ListItem', position: 3, name: '桃園市' },
    { '@type': 'ListItem', position: 4, name: '臺灣' },
  ],
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="relative min-h-[calc(100svh-var(--header-height))] overflow-hidden bg-ocean-deep text-white">
    <img
      src="/images/optimized/hero.webp"
      alt="白沙岬燈塔主視野——綠蔭與老樹之間的百年白塔（桃園市觀音區，臺灣）"
      width="2000"
      height="1333"
      sizes="100vw"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-[62%_48%]"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(8,35,44,.88)_0%,rgba(8,35,44,.58)_48%,rgba(8,35,44,.08)_100%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(8,35,44,.68)_0%,transparent_42%)]"></div>

    <div class="site-shell relative flex min-h-[calc(100svh-var(--header-height))] items-end pb-10 pt-24 md:items-center md:pb-20">
      <div class="max-w-3xl">
        <nav aria-label="位置導覽" class="mb-6 text-xs font-bold tracking-[.12em] text-white/60">
          <ol class="flex flex-wrap items-center gap-2">
            <li>白沙岬燈塔</li>
            <li aria-hidden="true">→</li>
            <li>觀音區</li>
            <li aria-hidden="true">→</li>
            <li>桃園市</li>
            <li aria-hidden="true">→</li>
            <li>臺灣</li>
          </ol>
        </nav>
        <p class="mb-5 flex items-center gap-3 text-xs font-extrabold tracking-[0.24em] text-white/75">
          <span class="h-px w-12 bg-sand"></span>桃園・觀音海岸
        </p>
        <h1 class="display-title text-white">白沙岬<br />燈塔<span class="mt-5 block text-base font-extrabold tracking-[.32em] text-white/85 md:text-lg">桃園市・觀音區</span></h1>
        <p class="mt-3 text-xs font-bold tracking-[.18em] text-white/65">Baishajia Lighthouse · Baisha Cape Lighthouse</p>
        <ul class="mt-6 flex flex-wrap gap-2 text-xs font-extrabold md:text-sm">
          <li class="rounded-full border border-white/30 bg-white/12 px-3.5 py-2 text-white backdrop-blur-md">免門票參觀</li>
          <li class="rounded-full border border-white/30 bg-white/12 px-3.5 py-2 text-white backdrop-blur-md">週二–週日 09:00–18:00（夏）</li>
          <li class="rounded-full border border-white/30 bg-white/12 px-3.5 py-2 text-white backdrop-blur-md">週一公休</li>
          <li class="rounded-full border border-white/30 bg-white/12 px-3.5 py-2 text-white backdrop-blur-md">停留 45–90 分鐘</li>
        </ul>
        <p class="mt-7 max-w-2xl text-lg font-medium leading-8 text-white/85 md:text-xl">
          走進綠蔭庭院，遇見一座仍為航海守望的百年白塔。開放時間、交通停車、拍照位置與海線行程，一頁完成規劃。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="focus-ring inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-extrabold text-ocean-deep shadow-xl transition hover:-translate-y-1" href="#visit">
            查看參觀資訊
            <span aria-hidden="true">↓</span>
          </a>
          <a class="focus-ring inline-flex items-center gap-2 rounded-full border border-white/35 bg-white/10 px-6 py-3.5 text-sm font-extrabold text-white backdrop-blur-md transition hover:bg-white/20" href="#route">
            規劃海線半日遊
          </a>
        </div>
      </div>

      <div class="absolute bottom-9 right-0 hidden items-center gap-3 border-l border-white/30 pl-5 text-xs tracking-[0.16em] text-white/65 xl:flex">
        <span class="h-12 w-px bg-white/30"></span>
        <span class="[writing-mode:vertical-rl]">25.0413° N · 121.0762° E</span>
      </div>
    </div>
  </section>

  <section id="visit" class="relative z-10 -mt-1 bg-foam pb-16 pt-8 md:-mt-10 md:rounded-t-[3rem] md:pb-24 md:pt-12">
    <div class="site-shell">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        {quickFacts.map((fact) => (
          <article class="soft-card min-h-40 p-5">
            <p class="text-xs font-extrabold tracking-[0.14em] text-ocean">{fact.label}</p>
            <p class="mt-5 text-xl font-extrabold tracking-tight text-ink">{fact.value}</p>
            <p class="mt-2 text-sm leading-6 text-ink/55">{fact.note}</p>
          </article>
        ))}
      </div>

      <div class="mt-8 grid gap-5 lg:grid-cols-[1.3fr_.7fr]">
        <article class="soft-card overflow-hidden p-6 md:p-9">
          <div>
            <p class="eyebrow">今天出發前</p>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight md:text-4xl">星期二至星期日<br />09:00 起開放</h2>
            <div class="mt-5 space-y-3">
              {seasonalHours.map((h) => (
                <div class="flex items-baseline justify-between gap-4 rounded-2xl bg-foam px-4 py-3">
                  <span class="font-extrabold text-ink">{h.season} <span class="text-xs font-bold text-ink/55">{h.period}</span></span>
                  <span class="font-black text-ocean">{h.opens}–{h.closes}</span>
                </div>
              ))}
            </div>
            <p class="mt-4 max-w-xl text-sm leading-7 text-ink/60">
              {weeklyClosure}。庭院與部分展示空間免費參觀，主燈塔室通常不開放。若遇維修、活動或特殊天候，現場可能臨時調整。
            </p>
            <p class="mt-5 text-xs font-bold tracking-[.08em] text-ocean">
              開放與票務資訊更新時間：{site.lastUpdated} · 依交通部觀光署公開資訊 · 出發前請以現場公告為準
            </p>
          </div>
        </article>

        <article class="soft-card p-6 md:p-9">
          <p class="text-xs font-extrabold tracking-[0.14em] text-ocean">地址</p>
          <p class="mt-4 text-2xl font-extrabold leading-tight">桃園市觀音區<br />光明路 216 號</p>
          <p class="mt-3 text-sm text-ink/55">舊址寫法：新坡下 16 號</p>
          <a class="focus-ring mt-6 inline-flex rounded-full bg-ocean px-5 py-3 text-sm font-extrabold text-white transition hover:bg-ocean-deep" href="https://www.google.com/maps/dir/?api=1&destination=25.041313,121.076243" target="_blank" rel="noopener noreferrer">
            開啟地圖導航 ↗
          </a>
        </article>
      </div>
    </div>
  </section>

  <Weather />

  <section id="story" class="section-pad lighthouse-grid border-y border-ocean/10 bg-paper">
    <div class="site-shell">
      <SectionHeading
        eyebrow="關於白沙岬燈塔"
        title="不只是一座好拍的白色燈塔"
        copy="白沙岬燈塔同時保存航海技術、磚石建築與海岸生活記憶。從塔身結構到庭院老樹，每一處都值得慢下來看。"
      />

      <div class="mt-8 max-w-3xl space-y-5 text-[1.02rem] leading-8 text-ink/70">
        <p>
          <strong class="text-ink">白沙岬燈塔（Baishajia Lighthouse）</strong>位於桃園市觀音區光明路 216 號，是臺灣現存少數仍持續執行助航任務的百年燈塔，也被旅客廣泛視為桃園海岸線上最具代表性的地標——一般所稱的「白沙岬燈塔」即指此地。
        </p>
        <p>
          造訪白沙岬燈塔時，旅客可順遊周邊地標，包括<strong class="text-ink">觀音濱海遊憩區</strong>與<strong class="text-ink">甘泉寺</strong>，輕鬆串聯成觀音海線半日或一日遊行程。
        </p>
      </div>

      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        {highlights.map((item) => (
          <article class="group rounded-[2rem] border border-ocean/10 bg-foam p-7 transition hover:-translate-y-1 hover:shadow-xl md:p-9">
            <div class="flex items-start justify-between gap-5">
              <span class="text-6xl font-black tracking-[-0.08em] text-ocean/12">{item.number}</span>
              <span class="mt-2 grid h-12 w-12 place-items-center rounded-full border border-ocean/20 text-ocean transition group-hover:bg-ocean group-hover:text-white" aria-hidden="true">↗</span>
            </div>
            <h3 class="mt-8 text-2xl font-extrabold tracking-tight">{item.title}</h3>
            <p class="mt-4 text-sm leading-7 text-ink/60">{item.body}</p>
          </article>
        ))}
      </div>

      <div class="mt-20 grid gap-8 lg:grid-cols-[.88fr_1.12fr] lg:items-center">
        <div class="photo-frame aspect-[4/5] min-h-[480px]">
          <img src="/images/optimized/tower-modern.webp" alt="白沙岬燈塔潔白圓形塔身與黑色燈室（桃園市觀音區）" width="1100" height="1467" sizes="(min-width: 1024px) 44vw, 100vw" loading="lazy" decoding="async" />
          <p class="photo-caption">圓形塔身向上收窄，白牆與深色燈室形成鮮明輪廓。</p>
        </div>
        <div class="lg:pl-10">
          <p class="eyebrow">建築細節</p>
          <h2 class="section-title">百年磚石工法，<br />仍在海岸守望</h2>
          <div class="mt-8 space-y-7">
            <div class="grid grid-cols-[auto_1fr] gap-5 border-b border-ocean/10 pb-7">
              <span class="text-sm font-black text-sand">01</span>
              <div>
                <h3 class="text-xl font-extrabold">雙同心圓塔體</h3>
                <p class="mt-2 text-sm leading-7 text-ink/60">塔身由內外兩層磚牆構成，中間整合樓梯與機械空間，是臺灣早期燈塔建築中少見的構造。</p>
              </div>
            </div>
            <div class="grid grid-cols-[auto_1fr] gap-5 border-b border-ocean/10 pb-7">
              <span class="text-sm font-black text-sand">02</span>
              <div>
                <h3 class="text-xl font-extrabold">燈器與旋轉機械</h3>
                <p class="mt-2 text-sm leading-7 text-ink/60">早期法國製透鏡、重錘與旋轉系統，讓燈塔不只是建築，也是一套完整的航海技術見證。</p>
              </div>
            </div>
            <div class="grid grid-cols-[auto_1fr] gap-5">
              <span class="text-sm font-black text-sand">03</span>
              <div>
                <h3 class="text-xl font-extrabold">戰後修復的身影</h3>
                <p class="mt-2 text-sm leading-7 text-ink/60">燈塔在戰時受損，戰後修復並繼續執行助航任務；如今所見高度與外觀，也承載這段歷史痕跡。</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-20">
        <p class="eyebrow">故事與傳說</p>
        <h2 class="mt-4 text-2xl font-extrabold tracking-tight md:text-3xl">地名、信仰與守塔人</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {stories.map((story) => (
            <article class="rounded-[2rem] border border-ocean/10 bg-foam p-7">
              <span class="inline-flex rounded-full bg-ocean-soft px-3 py-1 text-xs font-extrabold text-ocean">{story.tag}</span>
              <h3 class="mt-5 text-lg font-extrabold">{story.title}</h3>
              <p class="mt-3 text-sm leading-7 text-ink/60">{story.body}</p>
            </article>
          ))}
        </div>
        <p class="mt-6 text-xs leading-6 text-ink/45">民間傳說未必有文獻佐證，僅供文化參考；史實部分以文化資產與地方誌公開資料為準。</p>
      </div>
    </div>
  </section>

  <section id="photos" class="section-pad bg-ocean-deep text-white">
    <div class="site-shell">
      <SectionHeading
        eyebrow="拍照指南"
        title="從樹影裡，看見白塔"
        copy="白沙岬燈塔最迷人的畫面，不一定是貼近塔腳仰拍。拉開距離，讓林蔭、道路與天空成為構圖的一部分，更能拍出它在海岸守望的氣氛。"
      />

      <div class="mt-14 grid auto-rows-[230px] grid-cols-1 gap-4 md:grid-cols-12 md:auto-rows-[260px]">
        <figure class="photo-frame md:col-span-7 md:row-span-2">
          <img src="/images/optimized/entrance.webp" alt="從入口道路望向白沙岬燈塔（桃園市觀音區）" width="1600" height="1200" sizes="(min-width: 768px) 58vw, 100vw" loading="lazy" decoding="async" />
          <figcaption class="photo-caption"><strong>入口林蔭</strong>・用道路形成視線引導，適合拍完整環境。</figcaption>
        </figure>
        <figure class="photo-frame md:col-span-5">
          <img src="/images/optimized/tower-detail.webp" alt="近距離仰望白沙岬燈塔塔身（桃園市觀音區）" width="1100" height="1467" sizes="(min-width: 768px) 42vw, 100vw" loading="lazy" decoding="async" />
          <figcaption class="photo-caption"><strong>塔身側前方</strong>・微微仰角即可，不必極端廣角。</figcaption>
        </figure>
        <figure class="photo-frame md:col-span-5">
          <img src="/images/optimized/chinaberry-tree.webp" alt="白沙岬燈塔園區內的老苦楝樹（桃園市觀音區）" width="1280" height="960" sizes="(min-width: 768px) 42vw, 100vw" loading="lazy" decoding="async" />
          <figcaption class="photo-caption"><strong>老樹與庭院</strong>・春季枝葉與花色能柔化白塔線條。</figcaption>
        </figure>
        <figure class="photo-frame md:col-span-5">
          <img src="/images/optimized/lighthouse-park.webp" alt="白沙岬燈塔園區模型與周邊庭院（桃園市觀音區）" width="1280" height="960" sizes="(min-width: 768px) 42vw, 100vw" loading="lazy" decoding="async" />
          <figcaption class="photo-caption"><strong>園區細節</strong>・補拍日晷、模型與歷史展示，讓旅程更完整。</figcaption>
        </figure>
        <figure class="photo-frame md:col-span-7">
          <img src="/images/optimized/lighthouse-night.webp" alt="夜色中發出光束的白沙岬燈塔（桃園市觀音區）" width="1600" height="1067" sizes="(min-width: 768px) 58vw, 100vw" loading="lazy" decoding="async" />
          <figcaption class="photo-caption"><strong>航海之光</strong>・燈塔仍執行助航功能；日常參觀請遵守園區開放時間。</figcaption>
        </figure>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-white/12 bg-white/5 p-6">
          <p class="text-xs font-black tracking-[.15em] text-sand">上午</p>
          <p class="mt-3 font-extrabold">光線清爽、遊客較少</p>
          <p class="mt-2 text-sm leading-6 text-white/60">適合拍白塔與藍天，也較容易避開團體人潮。</p>
        </div>
        <div class="rounded-2xl border border-white/12 bg-white/5 p-6">
          <p class="text-xs font-black tracking-[.15em] text-sand">午後</p>
          <p class="mt-3 font-extrabold">樹影更有層次</p>
          <p class="mt-2 text-sm leading-6 text-white/60">約 15:00 後光線較柔和，可再銜接海岸夕陽。</p>
        </div>
        <div class="rounded-2xl border border-white/12 bg-white/5 p-6">
          <p class="text-xs font-black tracking-[.15em] text-sand">手機鏡頭</p>
          <p class="mt-3 font-extrabold">先用 1×，再試 2×</p>
          <p class="mt-2 text-sm leading-6 text-white/60">避免超廣角讓塔身過度變形，退後取景通常更耐看。</p>
        </div>
      </div>
    </div>
  </section>

  <section id="reviews" class="section-pad bg-paper">
    <div class="site-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:items-center">
      <div>
        <p class="eyebrow">遊客評價</p>
        <h2 class="section-title">來自 Google 地圖的<br />旅客評價</h2>
        <p class="section-copy">
          白沙岬燈塔在 Google 地圖上被歸類為「旅遊勝地」。以下評分概況同步自用戶評價，實際感受仍依季節、天候與參觀時段而不同。
        </p>
      </div>
      <article class="soft-card p-7 md:p-10">
        <div class="flex flex-wrap items-end gap-x-10 gap-y-6">
          <p class="text-6xl font-black tracking-[-.05em] text-ink md:text-7xl">
            4.2<span class="text-2xl font-extrabold text-ink/40"> / 5</span>
          </p>
          <div class="pb-2">
            <div class="relative text-2xl leading-none tracking-[.18em] text-sand/25" role="img" aria-label="Google 地圖評分 4.2，滿分 5 分">
              ★★★★★
              <span class="absolute inset-0 overflow-hidden whitespace-nowrap text-sand" style="width: 84%;">★★★★★</span>
            </div>
            <p class="mt-3 text-sm font-extrabold text-ink/75">6,382 則 Google 地圖用戶評價</p>
            <p class="mt-1 text-sm text-ink/55">Google 地圖分類：旅遊勝地</p>
